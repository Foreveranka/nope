+namespace veil {
+void register_bind_options(ez::ezOptionParser& opt);
+const std::string& bind_ipv4();
+const std::string& profile_pin();
+bool explicit_bind();
+bool valid_ipv4(const std::string& address);
+void configure_bind(bool enabled, const std::string& address, const std::string& pin);
+void validate_peer_file(const std::string& filename, int party, int base, int parties);
