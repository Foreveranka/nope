 using namespace std;
 
+namespace veil {
+static string configured_address = "127.0.0.1";
+static string configured_pin;
+const string& bind_ipv4() { return configured_address; }
+const string& profile_pin() { return configured_pin; }
+bool explicit_bind() { return not configured_pin.empty(); }
+bool valid_ipv4(const string& address)
+{
+  in_addr parsed;
+  char canonical[INET_ADDRSTRLEN];
+  if (inet_pton(AF_INET, address.c_str(), &parsed) != 1 or
+      not inet_ntop(AF_INET, &parsed, canonical, sizeof(canonical)) or address != canonical)
+    return false;
+  auto n = ntohl(parsed.s_addr);
+  return (n >> 24) != 0 and (n >> 24) < 224 and
+      (n >> 16) != 0xa9fe and n != 0x646464c8 and n != 0xa83f8110;
+}
+void configure_bind(bool enabled, const string& address, const string& pin)
+{
+  if (not enabled and address.empty() and pin.empty())
+    return;
+  if (not enabled or not valid_ipv4(address) or pin.size() != 64 or
+      pin == string(64, '0') or not all_of(pin.begin(), pin.end(), [](char c) {
+        return (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f'); }))
+    throw runtime_error("explicit bind requires opt-in, canonical IPv4 and approved profile pin");
+  if (explicit_bind() and (configured_address != address or configured_pin != pin))
+    throw runtime_error("cannot change explicit bind configuration");
+  configured_address = address;
+  configured_pin = pin;
+}
+void validate_peer_file(const string& filename, int party, int base, int parties)
+{
+  if (not explicit_bind()) return;
+  if (parties != 3 or party < 0 or party > 2 or base != 17500 or filename.empty())
+    throw runtime_error("explicit bind requires fixed three-party IP-file layout");
+  ifstream file(filename);
+  string line;
+  for (int i = 0; i < 3; ++i) {
+    if (not getline(file, line))
+      throw runtime_error("explicit bind requires complete peer file");
+    auto pos = line.find(':');
+    auto address = line.substr(0, pos);
+    if (pos == string::npos or not valid_ipv4(address) or
+        line.substr(pos + 1) != to_string(17500 + i) or
+        (i == party and address != bind_ipv4()))
+      throw runtime_error("explicit bind peer file mismatch");
+  }
+  if (getline(file, line))
+    throw runtime_error("explicit bind peer file has extra entries");
+  cerr << "VEIL_EXPLICIT_BIND party=" << party << " address=" << bind_ipv4()
+       << " profile=" << profile_pin() << endl;
+}
+}
