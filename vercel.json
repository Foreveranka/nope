{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 300
    },
    "api/procurement.mjs": {
      "maxDuration": 60
    },
    "api/csv-evidence.mjs": {
      "maxDuration": 30,
      "includeFiles": "api/csv-evidence-config.json"
    },
    "api/csv-gc.mjs": {
      "maxDuration": 60
    },
    "api/workspace.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/cloud/:route*",
      "destination": "/api/gateway?route=:route*"
    },
    {
      "source": "/api/procurement/:route*",
      "destination": "/api/procurement?route=:route*"
    },
    {
      "source": "/customer",
      "destination": "/workspace.html"
    },
    {
      "source": "/provider",
      "destination": "/workspace.html"
    },
    {
      "source": "/jobs",
      "destination": "/workspace.html"
    },
    {
      "source": "/jobs/new",
      "destination": "/workspace.html"
    },
    {
      "source": "/job",
      "destination": "/workspace.html"
    },
    {
      "source": "/offer",
      "destination": "/workspace.html"
    },
    {
      "source": "/delivery",
      "destination": "/workspace.html"
    },
    {
      "source": "/payments",
      "destination": "/workspace.html"
    },
    {
      "source": "/activity",
      "destination": "/workspace.html"
    },
    {
      "source": "/settings",
      "destination": "/workspace.html"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; worker-src 'self'"
        }
      ]
    },
    {
      "source": "/deployment.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/demo-evidence.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/privacy-evidence.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
