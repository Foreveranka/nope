{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci && npm ci --prefix planner-runtime --ignore-scripts && npm ci --prefix proof-runtime --ignore-scripts && npm ci --prefix wallet-runtime --ignore-scripts",
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 300
    },
    "api/procurement.mjs": {
      "maxDuration": 60
    },
    "api/csv-evidence.mjs": {
      "maxDuration": 30,
      "includeFiles": "api/csv-evidence-config.json"
    },
    "api/csv-gc.mjs": {
      "maxDuration": 60
    },
    "api/workspace.mjs": {
      "maxDuration": 60,
      "includeFiles": "proof-runtime/{assets/**,artifacts/**,node_modules/@aztec-foundation/bb.js/dest/node/barretenberg_wasm/barretenberg-threads.wasm.gz}"
    },
    "api/recipe-gc.mjs": {
      "maxDuration": 60
    },
    "api/plan-gc.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/cloud/:route*",
      "destination": "/api/gateway?route=:route*"
    },
    {
      "source": "/api/procurement/:route*",
      "destination": "/api/procurement?route=:route*"
    },
    {
      "source": "/customer",
      "destination": "/workspace"
    },
    {
      "source": "/provider",
      "destination": "/workspace"
    },
    {
      "source": "/jobs",
      "destination": "/workspace"
    },
    {
      "source": "/jobs/new",
      "destination": "/workspace"
    },
    {
      "source": "/job",
      "destination": "/workspace"
    },
    {
      "source": "/offer",
      "destination": "/workspace"
    },
    {
      "source": "/delivery",
      "destination": "/workspace"
    },
    {
      "source": "/payments",
      "destination": "/workspace"
    },
    {
      "source": "/activity",
      "destination": "/workspace"
    },
    {
      "source": "/settings",
      "destination": "/workspace"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://huggingface.co https://us.aws.cdn.hf.co https://test.rpc.fastnear.com; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; worker-src 'self'; frame-src 'self'"
        }
      ]
    },
    {
      "source": "/deployment.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/demo-evidence.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/privacy-evidence.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/wallet-runtime/bridge(\\.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://huggingface.co https://us.aws.cdn.hf.co https://test.rpc.fastnear.com; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; worker-src 'self'; frame-src 'self'"
        }
      ]
    },
    {
      "source": "/wallet-runtime/:asset*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
